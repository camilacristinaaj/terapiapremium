# Banco de dados
DB_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://terapiapremium:troque-esta-senha@localhost:5432/terapiapremium

# Chave mestra de criptografia (AES-256, 32 bytes em hex — 64 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# JWT
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Servidor
PORT=3000
NODE_ENV=development

# Redis (filas de transcrição)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Whisper (transcrição local)
WHISPER_WORKER_PATH=workers/whisper/transcribe.py
WHISPER_MODEL=base

# Storage de áudio criptografado
STORAGE_DIR=./storage
